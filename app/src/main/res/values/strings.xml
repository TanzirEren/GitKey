    <string name="guide_title">GitHub Actions Setup</string>
    <string name="guide_step1_title">1. Add Secrets to GitHub</string>
    <string name="guide_step1_desc">Go to your GitHub repo → Settings → Secrets and variables → Actions → New repository secret. Add the 4 secret values:</string>
    <string name="guide_step2_title">2. Decode Keystore in Workflow</string>
    <string name="guide_step2_desc">In your GitHub Actions workflow YAML, decode KEYSTORE_BASE64 back into a file before building:</string>
