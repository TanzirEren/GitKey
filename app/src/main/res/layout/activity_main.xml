<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainCoordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- Primary Fragment Host -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="90dp" />

    <!-- Main Floating Action Button (FAB) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCreateKey"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="100dp"
        android:text="@string/btn_create_new_key"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        app:icon="@drawable/ic_add"
        app:iconTint="#FFFFFF"
        app:iconSize="18dp"
        app:backgroundTint="?attr/colorPrimary"
        app:elevation="4dp"
        app:cornerRadius="26dp"
        android:contentDescription="@string/btn_create_new_key" />

    <!-- Google Stitch Floating Glass Bottom Dock -->
    <LinearLayout
        android:id="@+id/glassBottomBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_glass_nav"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <!-- Tab 1: Home -->
        <LinearLayout
            android:id="@+id/tabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:id="@+id/pillTabHome"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_nav_pill_active">

                <ImageView
                    android:id="@+id/ivTabHome"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_home"
                    app:tint="?attr/colorPrimary"
                    android:contentDescription="@string/nav_home" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTabHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_home"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorPrimary" />
        </LinearLayout>

        <!-- Tab 2: Keys -->
        <LinearLayout
            android:id="@+id/tabKeys"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:id="@+id/pillTabKeys"
                android:layout_width="48dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/ivTabKeys"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_key"
                    app:tint="?attr/colorTextMuted"
                    android:contentDescription="@string/nav_keys" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTabKeys"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_keys"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorTextMuted" />
        </LinearLayout>

        <!-- Tab 3: Tools -->
        <LinearLayout
            android:id="@+id/tabTools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:id="@+id/pillTabTools"
                android:layout_width="48dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/ivTabTools"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tools"
                    app:tint="?attr/colorTextMuted"
                    android:contentDescription="@string/nav_tools" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTabTools"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_tools"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorTextMuted" />
        </LinearLayout>

        <!-- Tab 4: Settings -->
        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <FrameLayout
                android:id="@+id/pillTabSettings"
                android:layout_width="48dp"
                android:layout_height="28dp">

                <ImageView
                    android:id="@+id/ivTabSettings"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_settings"
                    app:tint="?attr/colorTextMuted"
                    android:contentDescription="@string/nav_settings" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvTabSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_settings"
                android:textSize="10sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorTextMuted" />
        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
