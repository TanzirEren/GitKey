<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header & Close/Back -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/btnDone"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    app:tint="?attr/colorTextTitle"
                    android:contentDescription="Done" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_title"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="?attr/colorTextTitle" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_subtitle"
                        android:textSize="12sp"
                        android:textColor="?attr/colorTextMuted" />
                </LinearLayout>

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_check"
                    app:tint="@color/brand_emerald"
                    android:contentDescription="Success" />
            </LinearLayout>

            <!-- Success Summary Banner -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvResultProjectName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="?attr/colorTextTitle"
                            tools:text="NovaPlayer" />

                        <TextView
                            android:id="@+id/tvResultFileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_accent"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:textSize="12sp"
                            android:fontFamily="monospace"
                            android:textColor="?attr/colorPrimary"
                            tools:text="NovaPlayer-release.jks" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="4 GitHub Actions Secrets ready to copy or export below."
                        android:textSize="13sp"
                        android:textColor="?attr/colorTextBody" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Primary Action Buttons Row: COPY ALL & EXPORT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyAll"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/btn_copy_all"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_copy"
                    app:iconTint="#FFFFFF"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportFiles"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_export_files"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_download"
                    style="@style/Widget.Material3.Button.TonalButton" />
            </LinearLayout>

            <!-- Guide Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGithubGuide"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/btn_github_guide"
                android:textSize="13sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_info"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Secret 1: KEYSTORE_BASE64 Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/secret_keystore_base64"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleBase64"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/btn_show"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.TextButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyBase64"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/btn_copy"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="14dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_code_box"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvSecretBase64"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="11sp"
                            android:textColor="?attr/colorTextBody"
                            android:text="••••••••••••••••••••••••••••••••••••••••••••••••••••" />
                    </HorizontalScrollView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secret 2: KEYSTORE_PASSWORD Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/secret_keystore_password"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleKeystorePassword"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/btn_show"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.TextButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyKeystorePassword"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/btn_copy"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="14dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_code_box"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvSecretKeystorePassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:textColor="?attr/colorTextBody"
                            android:text="••••••••••••••••" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secret 3: KEY_ALIAS Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/secret_key_alias"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyKeyAlias"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/btn_copy"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="14dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_code_box"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvSecretKeyAlias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:textColor="?attr/colorTextBody"
                            tools:text="release_key" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secret 4: KEY_PASSWORD Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/secret_key_password"
                            android:textSize="14sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:textColor="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleKeyPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/btn_show"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.TextButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyKeyPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="@string/btn_copy"
                            android:textSize="11sp"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="14dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_code_box"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvSecretKeyPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:textColor="?attr/colorTextBody"
                            android:text="••••••••••••••••" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Certificate Fingerprints -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_fingerprints_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorTextTitle" />

                    <!-- SHA-256 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_sha256"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorTextMuted" />

                        <TextView
                            android:id="@+id/tvFingerprintSha256"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/bg_code_box"
                            android:padding="8dp"
                            android:fontFamily="monospace"
                            android:textSize="11sp"
                            android:textColor="?attr/colorTextBody"
                            tools:text="4A:21:8B:E3:..." />
                    </LinearLayout>

                    <!-- SHA-1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_sha1"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorTextMuted" />

                        <TextView
                            android:id="@+id/tvFingerprintSha1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/bg_code_box"
                            android:padding="8dp"
                            android:fontFamily="monospace"
                            android:textSize="11sp"
                            android:textColor="?attr/colorTextBody"
                            tools:text="9B:31:C4:..." />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
