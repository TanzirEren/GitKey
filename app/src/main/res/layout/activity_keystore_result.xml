<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header & Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_badge_pill">

                    <ImageButton
                        android:id="@+id/btnDone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_back"
                        app:tint="?attr/colorTextTitle"
                        android:contentDescription="Done" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_title"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="?attr/colorTextTitle"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/result_subtitle"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="?attr/colorTextMuted" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_success">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_check"
                        app:tint="@color/brand_emerald"
                        android:contentDescription="Success" />
                </FrameLayout>
            </LinearLayout>

            <!-- Success Summary Banner Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tvResultProjectName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textSize="17sp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="?attr/colorTextTitle"
                            tools:text="NovaPlayer" />

                        <TextView
                            android:id="@+id/tvResultFileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:textColor="?attr/colorPrimary"
                            tools:text="NovaPlayer-release.jks" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_dot_emerald"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 signing credentials generated locally &amp; ready to deploy."
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorTextBody" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Primary Action Buttons Row: COPY ALL & EXPORT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyAll"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="@string/btn_copy_all"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_copy"
                    app:iconTint="#FFFFFF"
                    app:iconSize="16dp"
                    android:backgroundTint="?attr/colorPrimary"
                    android:textColor="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportFiles"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="@string/btn_export_files"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-bold"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_download"
                    app:iconSize="16dp"
                    style="@style/Widget.Material3.Button.TonalButton" />
            </LinearLayout>

            <!-- Guide Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGithubGuide"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_github_guide"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_info"
                app:iconSize="16dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

            <!-- Section Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="GITHUB ACTIONS SECRETS"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="?attr/colorPrimary"
                android:letterSpacing="0.05" />

            <!-- Secret 1: KEYSTORE_BASE64 Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/secret_keystore_base64"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:textColor="?attr/colorTextTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="SECRET"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/brand_amber" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleBase64"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="@string/btn_show"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.TextButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyBase64"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="@string/btn_copy"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="13dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_code_box_stitch"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvSecretBase64"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="11sp"
                            android:textColor="?attr/colorTextBody"
                            android:text="••••••••••••••••••••••••••••••••••••••••••••••••••••" />
                    </HorizontalScrollView>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secret 2: KEYSTORE_PASSWORD Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/secret_keystore_password"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:textColor="?attr/colorTextTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="SECRET"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/brand_amber" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleKeystorePassword"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="@string/btn_show"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.TextButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyKeystorePassword"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="@string/btn_copy"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="13dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_code_box_stitch"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvSecretKeystorePassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="12sp"
                            android:textColor="?attr/colorTextBody"
                            android:text="••••••••••••••••" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secret 3: KEY_ALIAS Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/secret_key_alias"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:textColor="?attr/colorTextTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="PUBLIC"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyKeyAlias"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="@string/btn_copy"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="13dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_code_box_stitch"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvSecretKeyAlias"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="12sp"
                            android:textColor="?attr/colorTextBody"
                            tools:text="release_key" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Secret 4: KEY_PASSWORD Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/secret_key_password"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:textColor="?attr/colorTextTitle" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp"
                            android:text="SECRET"
                            android:textSize="9sp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="@color/brand_amber" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleKeyPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="@string/btn_show"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.TextButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyKeyPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="@string/btn_copy"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="13dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_code_box_stitch"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvSecretKeyPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="12sp"
                            android:textColor="?attr/colorTextBody"
                            android:text="••••••••••••••••" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Certificate Fingerprints -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="CERTIFICATE FINGERPRINTS"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="?attr/colorPrimary"
                android:letterSpacing="0.05" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use these fingerprints for Google Play Console, Firebase, and OAuth 2.0"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="?attr/colorTextMuted" />

                    <!-- SHA-256 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_sha256"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="?attr/colorTextMuted" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopySha256"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="@string/btn_copy"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-bold"
                                app:cornerRadius="6dp"
                                app:icon="@drawable/ic_copy"
                                app:iconSize="12dp"
                                style="@style/Widget.Material3.Button.TextButton" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFingerprintSha256"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_code_box_stitch"
                            android:padding="10dp"
                            android:fontFamily="monospace"
                            android:textSize="10sp"
                            android:textColor="?attr/colorCodeText"
                            tools:text="4A:21:8B:E3:FA:90:..." />
                    </LinearLayout>

                    <!-- SHA-1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_sha1"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="?attr/colorTextMuted" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnCopySha1"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:text="@string/btn_copy"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-bold"
                                app:cornerRadius="6dp"
                                app:icon="@drawable/ic_copy"
                                app:iconSize="12dp"
                                style="@style/Widget.Material3.Button.TextButton" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFingerprintSha1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/bg_code_box_stitch"
                            android:padding="10dp"
                            android:fontFamily="monospace"
                            android:textSize="10sp"
                            android:textColor="?attr/colorCodeText"
                            tools:text="9B:31:C4:02:..." />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
