<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/keys_title"
        android:textSize="24sp"
        android:fontFamily="sans-serif-black"
        android:textColor="?attr/colorTextTitle"
        android:layout_marginTop="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/keys_subtitle"
        android:textSize="13sp"
        android:textColor="?attr/colorTextMuted" />

    <!-- Security Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorCardStroke"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="?attr/colorCardBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_shield"
                app:tint="?attr/colorPrimary"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/keys_security_notice"
                android:textSize="11sp"
                android:textColor="?attr/colorTextBody" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Projects List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAllProjects"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        tools:listitem="@layout/item_project_card" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyKeys"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_key"
            app:tint="?attr/colorTextMuted"
            android:alpha="0.4"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/keys_empty_title"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorTextTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/keys_empty_desc"
            android:textSize="13sp"
            android:textColor="?attr/colorTextMuted"
            android:gravity="center" />
    </LinearLayout>

</LinearLayout>
