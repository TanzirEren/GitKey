<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="48dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top Header & Action Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_badge_pill">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_back"
                        app:tint="?attr/colorTextTitle"
                        android:contentDescription="Back" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Project Details"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:textColor="?attr/colorTextTitle"
                        android:letterSpacing="-0.02" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="Signing Keystore &amp; Secrets Hub"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="?attr/colorTextMuted" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill">

                    <ImageButton
                        android:id="@+id/btnCloneProject"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_copy"
                        app:tint="?attr/colorPrimary"
                        android:tooltipText="Clone Settings"
                        android:contentDescription="Clone Settings" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_badge_pill">

                    <ImageButton
                        android:id="@+id/btnEditProject"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_tools"
                        app:tint="?attr/colorTextTitle"
                        android:tooltipText="Edit Metadata"
                        android:contentDescription="Edit Project" />
                </FrameLayout>
            </LinearLayout>

            <!-- Hero Project Identity Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:background="@drawable/bg_icon_container">

                            <ImageView
                                android:id="@+id/ivProjectLogo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_gitkey_logo"
                                android:padding="8dp"
                                android:contentDescription="Project Logo" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvProjectName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="18sp"
                                android:fontFamily="sans-serif-black"
                                android:textColor="?attr/colorTextTitle"
                                tools:text="NovaPlayer" />

                            <TextView
                                android:id="@+id/tvCreatedDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif"
                                android:textColor="?attr/colorTextMuted"
                                tools:text="Created on Oct 11, 2026" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvProjectTag"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="?attr/colorPrimary"
                            tools:text="Release" />
                    </LinearLayout>

                    <!-- Status & Vault Info Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical">

                        <!-- Expiry Pill -->
                        <LinearLayout
                            android:id="@+id/pillExpiry"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_pill"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/dotStatus"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/bg_dot_emerald"
                                android:layout_marginEnd="6dp" />

                            <TextView
                                android:id="@+id/tvStatusBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="?attr/colorTextTitle"
                                tools:text="Active • 24 yrs left" />
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvFileName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:textColor="?attr/colorTextMuted"
                            tools:text="NovaPlayer-release.jks" />
                    </LinearLayout>

                    <!-- Vault Availability Banner -->
                    <LinearLayout
                        android:id="@+id/layoutVaultStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_code_box_stitch"
                        android:padding="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_shield"
                            app:tint="?attr/colorPrimary"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvVaultStatusText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Stored locally in GitKey vault. Full export available."
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="?attr/colorTextBody" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 1: Re-Download & Export Suite -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="RE-DOWNLOAD &amp; EXPORT FILES"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="?attr/colorPrimary"
                android:letterSpacing="0.05" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Primary Redownload Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDownloadJks"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="Redownload .JKS Keystore File"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_download"
                        app:iconSize="18dp"
                        android:backgroundTint="?attr/colorPrimary"
                        android:textColor="#FFFFFF" />

                    <!-- Grid of Secondary Export Actions -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportBase64"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="Base64 (.txt)"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_code"
                            app:iconSize="14dp"
                            style="@style/Widget.Material3.Button.TonalButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportEnv"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text=".ENV Secrets"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="14dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportYaml"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="6dp"
                            android:text="GitHub CI YAML"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_shield"
                            app:iconSize="14dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportPem"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="6dp"
                            android:text="Public Cert (.pem)"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="10dp"
                            app:icon="@drawable/ic_key"
                            app:iconSize="14dp"
                            style="@style/Widget.Material3.Button.OutlinedButton" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: Certificate Details & Identity -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="KEY IDENTIFIER &amp; ALIAS"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="?attr/colorPrimary"
                android:letterSpacing="0.05" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KEY ALIAS"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="?attr/colorTextMuted" />

                            <TextView
                                android:id="@+id/tvAlias"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="monospace"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorTextTitle"
                                tools:text="release_key" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyAlias"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Copy"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="13dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/colorDivider" />

                    <!-- Key Algorithm & Validity -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ALGORITHM"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="?attr/colorTextMuted" />

                            <TextView
                                android:id="@+id/tvAlgorithm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="?attr/colorTextTitle"
                                tools:text="RSA 2048" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="VALIDITY"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="?attr/colorTextMuted" />

                            <TextView
                                android:id="@+id/tvValidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-bold"
                                android:textColor="?attr/colorTextTitle"
                                tools:text="25 Years" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Distinguished Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="CERTIFICATE IDENTITY (DN)"
                        android:textSize="10sp"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="?attr/colorTextMuted" />

                    <TextView
                        android:id="@+id/tvDistinguishedName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_code_box_stitch"
                        android:padding="10dp"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:textColor="?attr/colorCodeText"
                        tools:text="CN=NovaPlayer Developer, O=GitKey, C=US" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: Certificate Fingerprints -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="CERTIFICATE FINGERPRINTS"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="?attr/colorPrimary"
                android:letterSpacing="0.05" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- SHA-256 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SHA-256 (Play Console / Firebase)"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopySha256"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Copy"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="12dp"
                            style="@style/Widget.Material3.Button.TextButton" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSha256"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bg_code_box_stitch"
                        android:padding="10dp"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textColor="?attr/colorCodeText"
                        tools:text="4A:21:8B:E3:FA:90:..." />

                    <!-- SHA-1 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="SHA-1 (Google OAuth / Maps)"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            android:textColor="?attr/colorPrimary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopySha1"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:text="Copy"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="6dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="12dp"
                            style="@style/Widget.Material3.Button.TextButton" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSha1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:background="@drawable/bg_code_box_stitch"
                        android:padding="10dp"
                        android:fontFamily="monospace"
                        android:textSize="10sp"
                        android:textColor="?attr/colorCodeText"
                        tools:text="9B:31:C4:02:..." />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 4: Gradle Signing Configuration Snippets -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="GRADLE BUILD INTEGRATION"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="?attr/colorPrimary"
                android:letterSpacing="0.05" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTabKotlinDsl"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Kotlin DSL (.kts)"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.TonalButton" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTabGroovy"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="8dp"
                            android:text="Groovy (.gradle)"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="8dp"
                            style="@style/Widget.Material3.Button.TextButton" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCopyGradle"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Copy"
                            android:textSize="11sp"
                            android:fontFamily="sans-serif-bold"
                            app:cornerRadius="8dp"
                            app:icon="@drawable/ic_copy"
                            app:iconSize="13dp"
                            style="@style/Widget.Material3.Button.TonalButton" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_code_box_stitch"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvGradleSnippet"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textSize="10sp"
                            android:textColor="?attr/colorCodeText"
                            tools:text="signingConfigs {\n    create(&quot;release&quot;) {\n        ...\n    }\n}" />
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card 5: Developer Notes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:text="DEVELOPER NOTES &amp; TAGS"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="?attr/colorPrimary"
                android:letterSpacing="0.05" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorCardStroke"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/tvNotes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif"
                        android:textColor="?attr/colorTextBody"
                        android:lineSpacingExtra="2dp"
                        tools:text="Production key used for Google Play release v1.0." />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickEditNotes"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="10dp"
                        android:text="Edit Notes"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-bold"
                        app:cornerRadius="8dp"
                        app:icon="@drawable/ic_tools"
                        app:iconSize="13dp"
                        style="@style/Widget.Material3.Button.TextButton" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Danger Zone / Delete -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteProject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:text="Delete This Project Record"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/brand_rose"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/brand_rose"
                app:iconSize="16dp"
                app:cornerRadius="14dp"
                style="@style/Widget.Material3.Button.OutlinedButton" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
