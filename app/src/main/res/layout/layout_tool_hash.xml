<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorCardStroke"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="?attr/colorCardBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Input Data"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="?attr/colorTextTitle" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilHashInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Enter text to hash"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxStrokeColor="?attr/colorPrimary"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etHashInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:gravity="top|start"
                    android:textSize="13sp"
                    android:textColor="?attr/colorTextTitle" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="— OR HASH A LOCAL FILE —"
                android:textSize="10sp"
                android:fontFamily="sans-serif-bold"
                android:textColor="?attr/colorTextMuted"
                android:letterSpacing="0.05"
                android:layout_gravity="center_horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSelectHashFile"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Choose File"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    app:icon="@drawable/ic_download"
                    app:iconSize="16dp"
                    app:cornerRadius="10dp"
                    style="@style/Widget.Material3.Button.TonalButton" />

                <TextView
                    android:id="@+id/tvSelectedHashFile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="No file chosen"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:textColor="?attr/colorTextMuted"
                    android:singleLine="true"
                    android:ellipsize="middle" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculateHash"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:text="CALCULATE HASH"
                android:textSize="14sp"
                android:fontFamily="sans-serif-bold"
                app:cornerRadius="14dp"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Hash Result Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHashResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorCardStroke"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="?attr/colorCardBackground"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvHashResultLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HASH OUTPUT"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="?attr/colorPrimary"
                    android:letterSpacing="0.05" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCopyHash"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:text="Copy"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-bold"
                    app:icon="@drawable/ic_copy"
                    app:iconSize="13dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.Material3.Button.TonalButton" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvHashOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_code_box_stitch"
                android:padding="12dp"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="?attr/colorCodeText"
                tools:text="e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
